# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=your_base58_private_key_here

# OpenRouter API (for AI trading agent and voice bot chat)
# Get your key from: https://openrouter.ai/keys
OPENAI_API_KEY=your_openrouter_api_key_here

# Mem0 API (for agent memory)
MEM0_API_KEY=your_mem0_api_key_here

# PumpPortal Trading Configuration
PRIORITY_FEE=0.00001
POOL=auto

# Jupiter API (optional, for enhanced token data)
JUPITER_API_KEY=

# Birdeye API (required, for token market data and trending tokens)
# Get your key from: https://birdeye.so
BIRDEYE_API_KEY=your_birdeye_api_key_here

# BitQuery API (for on-chain analytics and holder data)
# Get your keys from: https://bitquery.io/
BITQUERY_API_KEY_V1=your_bitquery_v1_api_key_here
BITQUERY_API_KEY_V2=your_bitquery_v2_api_key_here

# Trading Configuration
MAX_TRADE_AMOUNT_SOL=0.1
MIN_TRADE_AMOUNT_SOL=0.01
SLIPPAGE_BPS=100

# Autonomous Trading Settings
# AUTO_EXECUTE_TRADES: Set to 'true' to automatically execute trades (WARNING: real money!)
# Set to 'false' to analyze only without executing
AUTO_EXECUTE_TRADES=false
# Minimum AI confidence (0-100) required to auto-execute a trade
MIN_CONFIDENCE_FOR_AUTO_TRADE=75
# Minimum AI confidence (0-100) required to auto-execute high-risk trades
MIN_CONFIDENCE_FOR_HIGH_RISK=80
# How often to analyze the market (in minutes)
TRADING_INTERVAL_MINUTES=15

# Server Configuration
PORT=3000
WS_PORT=3001

# Twitter Spaces Bot Configuration
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here

# ElevenLabs API (optional, for high-quality voice synthesis)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Twitter Spaces Bot Settings
TWITTER_BOT_ENABLED=false
TWITTER_BOT_AUTO_JOIN=false
TWITTER_BOT_SEARCH_QUERY=crypto trading solana
TWITTER_BOT_TRADING_COMMENTARY=true
TWITTER_BOT_PERSONALITY=You are a knowledgeable crypto trading AI assistant. You provide insights on meme coins, Solana trading, and market trends. Keep responses brief and engaging.
